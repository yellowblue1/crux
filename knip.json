{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": [],
      "ignoreDependencies": ["@modelcontextprotocol/sdk"]
    },
    "tools/crux-monitor": {
      "entry": ["shared/types.ts", "**/*.test.ts"],
      "project": ["src/**/*.ts", "shared/**/*.ts"]
    },
    "tools/crux-monitor/web": {
      "vite": true,
      "entry": ["src/client/main.tsx", "**/*.test.ts"],
      "project": ["**/*.ts", "**/*.tsx"],
      "ignoreDependencies": ["tailwindcss"],
      "ignore": ["src/client/routeTree.gen.ts"]
    },
    "plugins/crux-hive": {
      "entry": ["src/ensure-gtrconfig.ts", "scripts/deregister-worker.ts", "**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts"]
    }
  }
}
