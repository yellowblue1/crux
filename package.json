{
  "name": "crux",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "plugins/crux-hive"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "depcruise": "bunx depcruise --config plugins/crux-hive/.dependency-cruiser.cjs plugins/crux-hive/src",
    "type-coverage": "type-coverage --at-least 95",
    "type-coverage:detail": "type-coverage --detail"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "bun-types": "latest",
    "dependency-cruiser": "^17.3.8",
    "husky": "^9.1.7",
    "knip": "^6.24.0",
    "lint-staged": "^16.3.2",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": [
      "biome check --write"
    ]
  }
}
