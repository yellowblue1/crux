{
  "$schema": "https://code.claude.com/schemas/settings.json",
  "_comment": "Copy this file to .claude/settings.local.json and customize for your project",
  "sandbox": {
    "mode": "auto-allow",
    "filesystem": {
      "allowWrite": [".", "/tmp"],
      "denyRead": ["~/.ssh", "~/.aws", "~/.docker", "~/.gnupg"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "api.github.com",
        "registry.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    }
  }
}
