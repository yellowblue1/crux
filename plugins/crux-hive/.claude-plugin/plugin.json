{
  "name": "crux-hive",
  "version": "4.2.0",
  "description": "Git worktree workflow with tmux integration for parallel Claude Code sessions",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun run ${CLAUDE_PLUGIN_ROOT}/src/ensure-gtrconfig.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun run ${CLAUDE_PLUGIN_ROOT}/scripts/hooks/auto-approve-watcher.ts"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "crux": {
      "command": "bun",
      "args": ["run", "${CLAUDE_PLUGIN_ROOT}/src/mcp/server.ts"]
    }
  }
}
